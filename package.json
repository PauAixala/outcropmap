{
  "name": "terrafirma-mapviewer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Chunkbase-style seed map viewer plus a TerraFirmaCraft forging calculator, for TerraFirmaCraft and TerraFirmaGreg. Runs fully client-side, as a static site.",
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "preview": "vite preview",
    "preview:render": "vitest run --config vitest.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run tests/parity",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md,css,html}\"",
    "extract:data": "node tools/extract-datapack.mjs",
    "build:web": "tsc --noEmit && vite build && node tools/finish-web-build.mjs",
    "prebuild:web": "node tools/prepare-out-dir.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {}
}
